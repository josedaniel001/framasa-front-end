# ============================================
# Variables de Entorno para FRAMASA ERP
# ============================================
# Copia este archivo como .env y ajusta los valores según tu entorno

# ============================================
# Docker Configuration
# ============================================
# Puerto donde se expondrá la aplicación
PORT=3000

# Imagen de Docker Hub para producción
# Reemplaza con tu usuario/repositorio de Docker Hub
DOCKER_IMAGE=josedaniel001/framasa-multiempresa-framasa-app:latest

# ============================================
# Next.js Public Variables
# ============================================
# URL base de la API Django (backend)
# IMPORTANTE: En producción, cambia a la URL real de tu servidor Django
# Esta variable se usa en el cliente (navegador) y se embebe durante el build
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# URL base de Next.js (frontend)
# IMPORTANTE: En producción, cambia a la URL real de tu servidor Next.js
NEXT_PUBLIC_NEXTJS_URL=http://localhost:3000

# ============================================
# Django API URL (Runtime - Prioritaria)
# ============================================
# URL base de la API Django para uso en el servidor (rutas API de Next.js)
# Esta variable tiene PRIORIDAD sobre NEXT_PUBLIC_API_URL en el servidor
# y puede ser configurada en runtime dentro del contenedor Docker
# 
# IMPORTANTE: En producción con Docker, configura esta variable según tu caso:
# - Si Django está en otro contenedor Docker: http://nombre-servicio:8000
# - Si Django está en otro servidor: https://api.tudominio.com
# - Si Django está en el mismo host: http://host.docker.internal:8000 (Docker Desktop)
# - Si Django está en el mismo host (Linux): http://172.17.0.1:8000 o la IP del host
DJANGO_API_URL=

# ============================================
# Database Configuration (Opcional)
# ============================================
# NOTA: Estas variables solo son necesarias si usas rutas API de Next.js
# que consultan directamente la base de datos (ej: /api/ferreteria/*)
# La mayoría de las rutas ahora usan Django como backend

# Host de PostgreSQL
DB_HOST=localhost

# Puerto de PostgreSQL
DB_PORT=5432

# Nombre de la base de datos
DB_NAME=framasa_db

# Usuario de PostgreSQL
DB_USER=postgres

# Contraseña de PostgreSQL
DB_PASSWORD=

# Usar SSL para conexión a la base de datos (true/false)
DB_SSL=false

# ============================================
# Ejemplos para diferentes entornos
# ============================================

# Desarrollo Local:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_NEXTJS_URL=http://localhost:3000

# Producción con dominio:
# NEXT_PUBLIC_API_URL=https://api.tudominio.com
# NEXT_PUBLIC_NEXTJS_URL=https://app.tudominio.com

# Docker en red local:
# NEXT_PUBLIC_API_URL=http://backend:8000
# NEXT_PUBLIC_NEXTJS_URL=http://frontend:3000


